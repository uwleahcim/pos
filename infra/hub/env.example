# Copied to /opt/pos/.env by bootstrap.sh, with a generated password. Never commit the real file.
POSTGRES_PASSWORD=change-me
POS_NODE=pos-hub1
# Optional: the same random value on every hub and the cloud (openssl rand -hex 32)
POS_SECRET=
# Optional: the restaurant's time zone (America/New_York unless set)
#POS_TIMEZONE=America/New_York
# Desk phones linked to screens (docs/desk-phones.md): written by `hubctl pbx link user@host`
#COMPOSE_PROFILES=pbx
#POS_PBX_SSH=root@freepbx.example.org
#POS_AMI_HOST=pbx
#POS_AMI_USER=pos
#POS_AMI_SECRET=
# Waking locked iPhones and iPads for calls (docs/push-relay.md): written by `hubctl push apple AuthKey_KEYID.p8 <key-id> <team-id>`
#POS_APNS_KEY=/apns/AuthKey_ABC123DEFG.p8
#POS_APNS_KEY_ID=ABC123DEFG
#POS_APNS_TEAM_ID=TEAM456789
#POS_APNS_BUNDLE_ID=org.chinasky.posApp
# Looking a delivery's distance up for the delivery fee (docs/delivery.md): written by `hubctl maps key`
#POS_MAPS=geocodio
#POS_MAPS_KEY=
#POS_MAPS_DAILY=500
# Google Maps as the second map service, asked when the first gives no distance: written by `hubctl maps google`
#POS_MAPS_GOOGLE_KEY=
#POS_MAPS_GOOGLE_DAILY=100
# The most Google is asked about the roads in a day, where live traffic is turned on in the app (Location, Live traffic)
#POS_MAPS_TRAFFIC_DAILY=150
