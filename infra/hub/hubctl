#!/usr/bin/env bash
# hubctl: everyday commands for a POS hub.
#   hubctl status | logs [service] | update | restart | psql | backup | printers <list> | print <printer-ip> [demo|ascii|drawer] [escpos|star] | menu import [--apply] | pbx key|link|status|tail|unlink | push apple|status|test|forget | maps key|status|test|forget
set -euo pipefail
POS_HOME=/opt/pos
POS_UID=10001 # the backend image's own user, which the pbx tunnel runs as

# The secrets in /opt/pos are root's, so run as root.
if [[ $EUID -ne 0 ]]; then
  exec sudo "$0" "$@"
fi

compose() {
  docker compose --project-directory "$POS_HOME" -f "$POS_HOME/src/infra/hub/docker-compose.yml" "$@"
}

case "${1:-status}" in
  status)
    echo "hub: $(hostname)   ip: $(hostname -I | awk '{print $1}')   up: $(uptime -p)"
    compose ps
    printf 'api:  '
    curl -fsS http://127.0.0.1:8000/health || printf 'down'
    echo
    printf 'pbx:  '
    curl -fsS http://127.0.0.1:8000/phones/status 2> /dev/null | jq -r 'if .configured then "\(.host) \(if .connected then "connected" else "NOT connected: \(.last_error // "")" end); \(.answers) answers, \(.pops) opened on a screen, \(.links) phones linked" else "not linked (hubctl pbx link)" end' || echo "unknown"
    printf 'push: '
    curl -fsS http://127.0.0.1:8000/push/status 2> /dev/null | jq -r 'if .configured then "key \(.key_id); \(.devices.voip + .devices.alert) tokens; \(.pushes.ring) rings, \(.pushes.pop) pick-ups" + (if .marks_error then "; TROUBLE marking the PBX: \(.marks_error)" else "" end) else "no Apple key (hubctl push apple)" end' || echo "unknown"
    printf 'time: '
    chronyc tracking 2> /dev/null | awk -F': *' '/^(Stratum|System time)/ {printf "%s %s; ", $1, $2}'
    echo
    echo "disk: $(df -h / | awk 'NR == 2 {print $4 " free of " $2}')"
    if command -v sensors > /dev/null; then sensors 2> /dev/null | grep -iE 'package|core 0|temp1' | head -2; fi
    ;;
  logs)
    shift
    compose logs -f --tail=200 "$@"
    ;;
  update)
    git -C "$POS_HOME/src" pull --ff-only
    install -m 0755 "$POS_HOME/src/infra/hub/hubctl" /usr/local/bin/hubctl
    docker build -t pos-backend:local "$POS_HOME/src/backend"
    compose up -d --remove-orphans
    compose ps
    ;;
  restart) compose restart ;;
  psql) compose exec db psql -U pos -d pos ;;
  printers)
    # hubctl printers kitchen=172.19.1.162/escpos,bar=172.19.1.14/star   (empty string clears)
    # Only a seed: the printers a manager saves in the app (Location settings > Printers) win once saved.
    [[ $# -ge 2 ]] || { echo "usage: hubctl printers name=host[:port][/escpos|star],..." >&2; exit 2; }
    sed -i -E '/^POS_PRINTERS=/d' "$POS_HOME/.env"
    printf 'POS_PRINTERS=%s\n' "$2" >> "$POS_HOME/.env"
    compose up -d api
    echo "POS_PRINTERS=$2"
    ;;
  print)
    # hubctl print 172.19.1.162 demo   (kitchen ticket, 80 mm)   |   hubctl print 172.19.1.162 drawer
    # hubctl print 172.19.1.162 identify   what the printer is and each answer it gave; prints nothing on paper
    [[ $# -ge 2 ]] || { echo "usage: hubctl print <printer-ip[:port]> [demo|ascii|drawer|identify] [escpos|star]" >&2; exit 2; }
    compose exec -T api python -m pos.printing --printer "$2" --dialect "${4:-escpos}" "${3:-demo}"
    ;;
  menu)
    # hubctl menu import           lists what the bundled menu files (a shelf of bottles, a printed price, say) would change
    # hubctl menu import --apply   applies it to the hub's menu; what the editor changed stays as it is
    [[ ${2:-} == import ]] || { echo "usage: hubctl menu import [--apply]" >&2; exit 2; }
    shift 2
    compose exec -T api python -m pos.menu.seed "$@"
    ;;
  pbx)
    # hubctl pbx key                         this hub's key for the PBX (made on first use) and the command that adds it by hand
    # hubctl pbx link root@pbx.example.org   puts the key on the PBX (its password once), asks for the AMI secret, saves the link in .env, starts the tunnel and the watcher and waits for them to meet
    # hubctl pbx status                      the tunnel and what the API says about the PBX
    # hubctl pbx tail                        prints each call as a desk phone answers it, as the hub sees it (Ctrl-C to stop)
    # hubctl pbx unlink                      stops the tunnel and forgets the link, secret included
    pbx_dir="$POS_HOME/pbx"
    pbx_key() {
      install -d -m 0700 -o "$POS_UID" -g "$POS_UID" "$pbx_dir"
      if [[ ! -f "$pbx_dir/id_ed25519" ]]; then
        ssh-keygen -q -t ed25519 -N '' -C "pos-$(hostname)" -f "$pbx_dir/id_ed25519"
        chown "$POS_UID:$POS_UID" "$pbx_dir/id_ed25519" "$pbx_dir/id_ed25519.pub"
      fi
    }
    unset_env() {
      for name in "$@"; do sed -i -E "/^$name=/d" "$POS_HOME/.env"; done
    }
    pbx_ssh() { # to the PBX as the tunnel goes: the hub's key, and the PBX's host key kept where the tunnel reads it
      ssh -i "$pbx_dir/id_ed25519" -o ConnectTimeout=15 -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile="$pbx_dir/known_hosts" "$@"
    }
    pbx_line() { # the authorized_keys line: with it the hub may only forward to the manager port, no shell on the PBX
      printf 'restrict,port-forwarding,permitopen="127.0.0.1:5038" %s\n' "$(cat "$pbx_dir/id_ed25519.pub")"
    }
    ago() { # seconds, for people
      if (( $1 < 60 )); then echo "$1 s"; elif (( $1 < 3600 )); then echo "$(( $1 / 60 )) min"; else echo "$(( $1 / 3600 )) h $(( $1 % 3600 / 60 )) min"; fi
    }
    pbx_status() { # the tunnel container as it stands now (its current run only: old log lines say nothing), then the API's view
      local cid state started since uptime logs
      cid=$(compose ps -aq pbx 2> /dev/null | head -n 1 || true)
      if [[ -z "$cid" ]]; then
        echo "tunnel: not set up (hubctl pbx link)"
      else
        state=$(docker inspect -f '{{.State.Status}}' "$cid")
        started=$(docker inspect -f '{{.State.StartedAt}}' "$cid")
        since=${started%%.*}
        since=${since%Z}Z
        uptime=$(( $(date +%s) - $(date -d "$since" +%s) ))
        logs=$(docker logs --since "$started" "$cid" 2>&1 | tail -n 5 || true)
        if [[ "$state" == running ]]; then
          if (( uptime < 15 )); then echo "tunnel: up for $(ago "$uptime"), connecting"; else echo "tunnel: up for $(ago "$uptime")"; fi
        else
          echo "tunnel: $state ($(docker inspect -f '{{.RestartCount}}' "$cid") restarts); its last words:"
        fi
        [[ -z "$logs" ]] || while IFS= read -r line; do echo "  | $line"; done <<< "$logs"
        if grep -q "Permission denied (publickey" <<< "$logs"; then
          echo "=> the PBX refuses the hub's key: hubctl pbx link again puts it there (hubctl pbx key prints it, to add by hand)"
        fi
        if grep -q "Host key verification failed\|HOST IDENTIFICATION HAS CHANGED" <<< "$logs"; then
          echo "=> the PBX's host key is not the one the hub knows (reinstalled?): rm $pbx_dir/known_hosts, then hubctl pbx link again"
        fi
      fi
      curl -fsS http://127.0.0.1:8000/phones/status | jq . || echo "api: down"
    }
    case "${2:-status}" in
      key)
        pbx_key
        line=$(pbx_line)
        echo "This hub's key for the PBX. hubctl pbx link root@<pbx> puts it on the PBX itself (the PBX asks for root's"
        echo "password once); to add it by hand instead, run this from any machine that reaches the PBX, as one line:"
        echo
        echo "  ssh root@<pbx> 'echo \"${line//\"/\\\"}\" >> ~/.ssh/authorized_keys'"
        echo
        echo "$line"
        ;;
      link)
        [[ $# -ge 3 ]] || { echo "usage: hubctl pbx link user@pbx-host [ami-user]" >&2; exit 2; }
        pbx_key
        if pbx_ssh -o BatchMode=yes "$3" true 2> /dev/null; then
          echo "The PBX accepts the hub's key."
        else
          echo "The PBX does not accept the hub's key yet: adding it (the PBX asks for the password of $3 once)."
          line=$(pbx_line)
          pbx_ssh "$3" "umask 077; mkdir -p ~/.ssh; grep -qxF '$line' ~/.ssh/authorized_keys 2> /dev/null || echo '$line' >> ~/.ssh/authorized_keys" \
            || { echo "Could not add the key; nothing changed. hubctl pbx key prints it, to add by hand." >&2; exit 1; }
          pbx_ssh -o BatchMode=yes "$3" true 2> /dev/null \
            || { echo "The key is on the PBX, but the PBX still refuses it (sshd there does not read ~/.ssh/authorized_keys?); the link was not written." >&2; exit 1; }
          echo "The PBX accepts the hub's key now."
        fi
        chown "$POS_UID:$POS_UID" "$pbx_dir/known_hosts" 2> /dev/null || true
        saved=$(sed -nE 's/^POS_AMI_SECRET=//p' "$POS_HOME/.env" 2> /dev/null | tail -n 1)
        keeps=""
        [[ -z "$saved" ]] || keeps="; Enter keeps the saved one"
        read -rsp "Secret of the AMI user ${4:-pos} (FreePBX > Settings > Asterisk Manager Users$keeps): " secret
        echo
        secret=${secret:-$saved}
        [[ -n "$secret" ]] || { echo "no secret given; nothing changed" >&2; exit 2; }
        unset_env COMPOSE_PROFILES POS_PBX_SSH POS_AMI_HOST POS_AMI_PORT POS_AMI_USER POS_AMI_SECRET POS_AMI_TLS
        (
          umask 077
          printf 'COMPOSE_PROFILES=pbx\nPOS_PBX_SSH=%s\nPOS_AMI_HOST=pbx\nPOS_AMI_USER=%s\nPOS_AMI_SECRET=%s\n' "$3" "${4:-pos}" "$secret" >> "$POS_HOME/.env"
        )
        compose up -d --force-recreate pbx # a fresh start, not the tail of a restart loop
        compose up -d api
        echo "Linked to $3. Waiting for the hub to reach the PBX through the tunnel..."
        for _ in $(seq 1 45); do
          sleep 1
          if [[ "$(curl -fsS http://127.0.0.1:8000/phones/status 2> /dev/null | jq -r '.connected' 2> /dev/null || true)" == true ]]; then
            echo "The hub watches the PBX. hubctl pbx tail prints each call a desk phone answers; the phones are linked to screens under Location settings, Desk phones."
            exit 0
          fi
        done
        echo "Not reached within 45 s. Where it stands:"
        pbx_status
        exit 1
        ;;
      status)
        pbx_status
        ;;
      tail)
        # shellcheck disable=SC2016  # the variables are the container's, expanded in there
        compose exec -T api sh -c 'exec python -m pos.phones.deskphones --host "$POS_AMI_HOST" --port "$POS_AMI_PORT" --user "$POS_AMI_USER" --secret-env POS_AMI_SECRET'
        ;;
      unlink)
        unset_env COMPOSE_PROFILES POS_PBX_SSH POS_AMI_HOST POS_AMI_PORT POS_AMI_USER POS_AMI_SECRET POS_AMI_TLS
        compose --profile pbx stop pbx 2> /dev/null || true
        compose --profile pbx rm -f pbx 2> /dev/null || true
        compose up -d api
        echo "The hub no longer watches the PBX; the key in $pbx_dir stays."
        ;;
      *)
        echo "usage: hubctl pbx key | link user@pbx-host [ami-user] | status | tail | unlink" >&2
        exit 2
        ;;
    esac
    ;;
  push)
    # hubctl push apple AuthKey_KEYID.p8 <key-id> <team-id> [bundle-id]   puts Apple's push key on the hub (the API's user reads it, nobody else), saves the ids in .env, restarts the API
    # hubctl push status                                                  the key, the tokens the screens registered, the extensions marked on the PBX, what went out
    # hubctl push test <device> [alert|voip]                              a notification (or a test call) to that screen, by the name it shows in its status
    # hubctl push forget                                                  removes the key and the ids: no more pushes
    apns_dir="$POS_HOME/apns"
    unset_env() {
      for name in "$@"; do sed -i -E "/^$name=/d" "$POS_HOME/.env"; done
    }
    push_status() {
      curl -fsS http://127.0.0.1:8000/push/status 2> /dev/null | jq -r '
        (if .configured then "key: \(.key_id), team \(.team_id), bundle \(.bundle); \(.sent) sent, \(.failed) failed" + (if .last_error then " (last: \(.last_error))" else "" end) else "key: none (hubctl push apple AuthKey_KEYID.p8 <key-id> <team-id>)" end),
        "tokens: \(.devices.voip) for calls, \(.devices.alert) for pick-ups",
        (.list[] | "  \(.device)  \(.platform)  \(.kind)" + (if .extension != "" then "  extension \(.extension)" else "" end) + (if .env then "  (\(.env))" else "" end)),
        ("pbx: " + (if .pbx then "connected; marked for push: " + (if (.marks | length) > 0 then (.marks | join(", ")) else "nothing" end) + (if .marks_error then "; TROUBLE: \(.marks_error)" else "" end) + (if .hook_seen then "; the pre-dial hook spoke" else "; the pre-dial hook has not spoken yet (docs/push-relay.md, step 7)" end) else "not connected" end)),
        "pushes: \(.pushes.ring) rings, \(.pushes.pop) pick-ups, \(.pushes.test) tests"' || echo "the API is not answering"
    }
    case "${2:-status}" in
      apple)
        [[ $# -ge 5 ]] || { echo "usage: hubctl push apple <AuthKey_KEYID.p8> <key-id> <team-id> [bundle-id]" >&2; exit 2; }
        [[ -f "$3" ]] || { echo "no such file: $3" >&2; exit 2; }
        grep -q 'PRIVATE KEY' "$3" || { echo "$3 is not a .p8 key: no PRIVATE KEY in it" >&2; exit 2; }
        [[ "$4" =~ ^[A-Z0-9]{10}$ ]] || { echo "the key id is the ten letters and digits in the file's name, AuthKey_<key id>.p8, not '$4'" >&2; exit 2; }
        [[ "$5" =~ ^[A-Z0-9]{10}$ ]] || { echo "the team id is ten letters and digits (Membership details in the Apple developer account), not '$5'" >&2; exit 2; }
        install -d -m 0700 -o "$POS_UID" -g "$POS_UID" "$apns_dir"
        install -m 0400 -o "$POS_UID" -g "$POS_UID" "$3" "$apns_dir/AuthKey_$4.p8"
        unset_env POS_APNS_KEY POS_APNS_KEY_ID POS_APNS_TEAM_ID POS_APNS_BUNDLE_ID
        printf 'POS_APNS_KEY=/apns/AuthKey_%s.p8\nPOS_APNS_KEY_ID=%s\nPOS_APNS_TEAM_ID=%s\n' "$4" "$4" "$5" >> "$POS_HOME/.env"
        if [[ -n "${6:-}" ]]; then printf 'POS_APNS_BUNDLE_ID=%s\n' "$6" >> "$POS_HOME/.env"; fi
        compose up -d api
        echo "The key is on the hub. Waiting for the API to pick it up..."
        for _ in $(seq 1 30); do
          sleep 1
          if [[ "$(curl -fsS http://127.0.0.1:8000/push/status 2> /dev/null | jq -r '.configured' 2> /dev/null || true)" == true ]]; then
            echo "The hub pushes as team $5 with key $4 for ${6:-org.chinasky.posApp}. Next: on an iPhone, turn the phone on in the app (or link a desk phone to it), then hubctl push test <device>."
            exit 0
          fi
        done
        echo "The API did not come up with the key within 30 s. hubctl logs api says why; hubctl push forget takes the key off again."
        exit 1
        ;;
      status)
        push_status
        ;;
      test)
        [[ $# -ge 3 ]] || { echo "usage: hubctl push test <device> [alert|voip]" >&2; exit 2; }
        curl -fsS -X POST -H 'content-type: application/json' -d "{\"device\":\"$3\",\"kind\":\"${4:-alert}\"}" http://127.0.0.1:8000/push/test \
          | jq -r 'if .configured | not then "no Apple key on this hub (hubctl push apple)" elif .tokens == 0 then "\(.device) has registered no \(.kind) token on this hub: open the app on it (for voip, turn the phone on in the app)" else (.results[] | "\(.device) \(.platform) \(.kind): " + (if .ok then "sent (\(.env))" else "FAILED: \(.reason)" end)) end'
        ;;
      forget)
        unset_env POS_APNS_KEY POS_APNS_KEY_ID POS_APNS_TEAM_ID POS_APNS_BUNDLE_ID
        rm -rf "$apns_dir"
        compose up -d api
        echo "The key is gone; the hub sends no pushes until hubctl push apple puts one back."
        ;;
      *)
        echo "usage: hubctl push apple <AuthKey_KEYID.p8> <key-id> <team-id> [bundle-id] | status | test <device> [alert|voip] | forget" >&2
        exit 2
        ;;
    esac
    ;;
  maps)
    # hubctl maps key                puts a map service's key on the hub (asked for and not shown, never on the command line), restarts the API
    # hubctl maps status             whether the hub has a key, whether the restaurant's own address is set, how often it asked today
    # hubctl maps test "<address>"   asks how far an address is, as a delivery's form does
    # hubctl maps forget             removes the key: no distance is looked up, and the delivery fee is picked by hand
    unset_env() {
      for name in "$@"; do sed -i -E "/^$name=/d" "$POS_HOME/.env"; done
    }
    maps_status() {
      curl -fsS http://127.0.0.1:8000/maps/status 2> /dev/null | jq -r '
        (if .configured then "map service: \(.service); asked \(.asked_today) times today (at most \(.daily_most)), \(.failed_today) gave no distance" + (if .last_failure then " (last: \(.last_failure))" else "" end) else "map service: none (hubctl maps key)" end),
        (if .origin_set then "the restaurant\u0027s own address: set" else "the restaurant\u0027s own address: not set (in the app: Location, Delivery fee)" end)' || echo "the API is not answering, or is older than the lookup (hubctl update)"
    }
    case "${2:-status}" in
      key)
        read -rsp "The map service's API key (it is not shown as you paste it): " key
        echo
        key=${key//[[:space:]]/}
        [[ -n "$key" ]] || { echo "no key given; nothing changed" >&2; exit 2; }
        [[ "$key" =~ ^[A-Za-z0-9_-]{16,128}$ ]] || { echo "that does not look like a key (letters and digits, 16 or more, no spaces); nothing changed" >&2; exit 2; }
        unset_env POS_MAPS POS_MAPS_KEY
        printf 'POS_MAPS=geocodio\nPOS_MAPS_KEY=%s\n' "$key" >> "$POS_HOME/.env"
        unset key
        compose up -d api
        echo "The key is on the hub. Waiting for the API to pick it up..."
        for _ in $(seq 1 30); do
          sleep 1
          if [[ "$(curl -fsS http://127.0.0.1:8000/maps/status 2> /dev/null | jq -r '.configured' 2> /dev/null || true)" == true ]]; then
            maps_status
            echo "Next: in the app, Location, Delivery fee: type the restaurant's own address. Then: hubctl maps test \"an address nearby\""
            exit 0
          fi
        done
        echo "The API did not come up with the key within 30 s. hubctl logs api says why; hubctl maps forget takes the key off again."
        exit 1
        ;;
      status)
        maps_status
        ;;
      test)
        [[ $# -ge 3 ]] || { echo 'usage: hubctl maps test "<address>"' >&2; exit 2; }
        jq -n --arg address "$3" '{address: $address}' \
          | curl -sS -X POST -H 'content-type: application/json' -d @- http://127.0.0.1:8000/delivery/distance \
          | jq -r 'if (.detail | type) == "object" then .detail.message elif .detail then (.detail | tostring) else "\(.miles) mi, \(.minutes) min" + (if .band then ": $\(.band.fee) (up to \(.band.up_to) \(.by))" elif .beyond then ": further than the prices reach" else ": no fee is charged" end) end'
        ;;
      forget)
        unset_env POS_MAPS POS_MAPS_KEY
        compose up -d api
        echo "The key is gone; no distance is looked up, and the delivery fee is picked by hand."
        ;;
      *)
        echo 'usage: hubctl maps key | status | test "<address>" | forget' >&2
        exit 2
        ;;
    esac
    ;;
  backup)
    mkdir -p /var/backups/pos
    file="/var/backups/pos/pos-$(date +%Y%m%d-%H%M%S).sql.gz"
    compose exec -T db pg_dump -U pos pos | gzip > "$file"
    echo "$file"
    ;;
  *)
    echo "usage: hubctl status | logs [service] | update | restart | psql | backup | printers <list> | print <printer-ip> [demo|ascii|drawer] [escpos|star] | menu import [--apply] | pbx key|link|status|tail|unlink | push apple|status|test|forget | maps key|status|test|forget" >&2
    exit 2
    ;;
esac
