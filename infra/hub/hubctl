#!/usr/bin/env bash
# hubctl: everyday commands for a POS hub.
#   hubctl status | logs [service] | update | restart | psql | backup | printers <list> | print <printer-ip> [demo|ascii|drawer] [escpos|star] | menu import [--apply] | pbx key|link|status|tail|unlink | push apple|status|test|forget | maps key|google|status|test|forget | online key|status|fetch|show|forget|push key|push test|push forget|tunnel token|tunnel status|tunnel forget | staff [pin <id or name>]
set -euo pipefail
POS_HOME=/opt/pos
POS_UID=10001 # the backend image's own user, which the pbx tunnel runs as

# The secrets in /opt/pos are root's, so run as root.
if [[ $EUID -ne 0 ]]; then
  exec sudo "$0" "$@"
fi

compose() {
  docker compose --project-directory "$POS_HOME" -f "$POS_HOME/src/infra/hub/docker-compose.yml" "$@"
}

# An optional service of the hub (the PBX tunnel) runs under a profile, and the profiles that are on are one
# line of /opt/pos/.env. These turn one on or off and leave the others as they are. The push door and the
# way in for pushes used to have profiles of their own (`push`, `tunnel`); they run all the time now, idle
# until the hub has their keys, and what is left of those two names in the file means nothing.
profiles() {
  sed -nE 's/^COMPOSE_PROFILES=//p' "$POS_HOME/.env" 2> /dev/null | tail -n 1
}
profile_on() {
  local now
  now=$(profiles)
  case ",$now," in *",$1,"*) return 0 ;; esac
  sed -i -E '/^COMPOSE_PROFILES=/d' "$POS_HOME/.env"
  printf 'COMPOSE_PROFILES=%s\n' "${now:+$now,}$1" >> "$POS_HOME/.env"
}
profile_off() {
  local now left
  now=$(profiles)
  left=$(tr ',' '\n' <<< "$now" | grep -vxF -e "$1" -e '' | paste -sd, - || true)
  sed -i -E '/^COMPOSE_PROFILES=/d' "$POS_HOME/.env"
  [[ -z "$left" ]] || printf 'COMPOSE_PROFILES=%s\n' "$left" >> "$POS_HOME/.env"
}

# A key told to the hub here, from its terminal, is the one in force from then on: what a manager typed for
# it in the app (Location, Keys and connections; docs/hub-keys.md) is taken off the hub. Of the two ways
# the one used last wins. Nothing happens on a hub from before the app held keys.
app_key_off() {
  compose exec -T db psql -U pos -d pos -qc "DELETE FROM hub_key WHERE name = '$1'" > /dev/null 2>&1 || true
}

case "${1:-status}" in
  status)
    echo "hub: $(hostname)   ip: $(hostname -I | awk '{print $1}')   up: $(uptime -p)"
    compose ps
    printf 'api:  '
    curl -fsS http://127.0.0.1:8000/health || printf 'down'
    echo
    printf 'pbx:  '
    curl -fsS http://127.0.0.1:8000/phones/status 2> /dev/null | jq -r 'if .configured then "\(.host) \(if .connected then "connected" else "NOT connected: \(.last_error // "")" end); \(.answers) answers, \(.pops) opened on a screen, \(.links) phones linked" else "not linked (hubctl pbx link)" end' || echo "unknown"
    printf 'push: '
    curl -fsS http://127.0.0.1:8000/push/status 2> /dev/null | jq -r 'if .configured then "key \(.key_id); \(.devices.voip + .devices.alert) tokens; \(.pushes.ring) rings, \(.pushes.pop) pick-ups" + (if .marks_error then "; TROUBLE marking the PBX: \(.marks_error)" else "" end) else "no Apple key (hubctl push apple)" end' || echo "unknown"
    printf 'time: '
    chronyc tracking 2> /dev/null | awk -F': *' '/^(Stratum|System time)/ {printf "%s %s; ", $1, $2}'
    echo
    echo "disk: $(df -h / | awk 'NR == 2 {print $4 " free of " $2}')"
    if command -v sensors > /dev/null; then sensors 2> /dev/null | grep -iE 'package|core 0|temp1' | head -2; fi
    ;;
  logs)
    shift
    compose logs -f --tail=200 "$@"
    ;;
  update)
    git -C "$POS_HOME/src" pull --ff-only
    install -m 0755 "$POS_HOME/src/infra/hub/hubctl" /usr/local/bin/hubctl
    # Cloudflare's tunnel program is built into the image, from Cloudflare's own as it is today: a build
    # goes by the copy the hub already has, so the current one is fetched first. Where Cloudflare's registry
    # cannot be reached the hub's copy does (a first build has none, and says so itself).
    # POS_TUNNEL_IMAGE in /opt/pos/.env names another one (cloudflare/cloudflared:<version>) to stay on.
    build_args=()
    tunnel_image=$(sed -nE 's/^POS_TUNNEL_IMAGE=//p' "$POS_HOME/.env" 2> /dev/null | tail -n 1)
    [[ -z "$tunnel_image" ]] || build_args+=(--build-arg "CLOUDFLARED_IMAGE=$tunnel_image")
    docker pull -q "${tunnel_image:-cloudflare/cloudflared:latest}" > /dev/null \
      || echo "Could not look for a newer tunnel program at Cloudflare; building with the one this hub has." >&2
    docker build "${build_args[@]}" -t pos-backend:local "$POS_HOME/src/backend"
    compose up -d --remove-orphans
    compose ps
    ;;
  restart) compose restart ;;
  psql) compose exec db psql -U pos -d pos ;;
  printers)
    # hubctl printers kitchen=172.19.1.162/escpos,bar=172.19.1.14/star   (empty string clears)
    # Only a seed: the printers a manager saves in the app (Location settings > Printers) win once saved.
    [[ $# -ge 2 ]] || { echo "usage: hubctl printers name=host[:port][/escpos|star],..." >&2; exit 2; }
    sed -i -E '/^POS_PRINTERS=/d' "$POS_HOME/.env"
    printf 'POS_PRINTERS=%s\n' "$2" >> "$POS_HOME/.env"
    compose up -d api
    echo "POS_PRINTERS=$2"
    ;;
  print)
    # hubctl print 172.19.1.162 demo   (kitchen ticket, 80 mm)   |   hubctl print 172.19.1.162 drawer
    # hubctl print 172.19.1.162 identify   what the printer is and each answer it gave; prints nothing on paper
    [[ $# -ge 2 ]] || { echo "usage: hubctl print <printer-ip[:port]> [demo|ascii|drawer|identify] [escpos|star]" >&2; exit 2; }
    compose exec -T api python -m pos.printing --printer "$2" --dialect "${4:-escpos}" "${3:-demo}"
    ;;
  menu)
    # hubctl menu import           lists what the bundled menu files (a shelf of bottles, a printed price, say) would change
    # hubctl menu import --apply   applies it to the hub's menu; what the editor changed stays as it is
    [[ ${2:-} == import ]] || { echo "usage: hubctl menu import [--apply]" >&2; exit 2; }
    shift 2
    compose exec -T api python -m pos.menu.seed "$@"
    ;;
  pbx)
    # hubctl pbx key                         this hub's key for the PBX (made on first use) and the command that adds it by hand
    # hubctl pbx link root@pbx.example.org   puts the key on the PBX (its password once), asks for the AMI secret, saves the link in .env, starts the tunnel and the watcher and waits for them to meet
    # hubctl pbx status                      the tunnel and what the API says about the PBX
    # hubctl pbx tail                        prints each call as a desk phone answers it, as the hub sees it (Ctrl-C to stop)
    # hubctl pbx unlink                      stops the tunnel and forgets the link, secret included
    pbx_dir="$POS_HOME/pbx"
    pbx_key() {
      install -d -m 0700 -o "$POS_UID" -g "$POS_UID" "$pbx_dir"
      if [[ ! -f "$pbx_dir/id_ed25519" ]]; then
        ssh-keygen -q -t ed25519 -N '' -C "pos-$(hostname)" -f "$pbx_dir/id_ed25519"
        chown "$POS_UID:$POS_UID" "$pbx_dir/id_ed25519" "$pbx_dir/id_ed25519.pub"
      fi
    }
    unset_env() {
      for name in "$@"; do sed -i -E "/^$name=/d" "$POS_HOME/.env"; done
    }
    pbx_ssh() { # to the PBX as the tunnel goes: the hub's key, and the PBX's host key kept where the tunnel reads it
      ssh -i "$pbx_dir/id_ed25519" -o ConnectTimeout=15 -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile="$pbx_dir/known_hosts" "$@"
    }
    pbx_line() { # the authorized_keys line: with it the hub may only forward to the manager port, no shell on the PBX
      printf 'restrict,port-forwarding,permitopen="127.0.0.1:5038" %s\n' "$(cat "$pbx_dir/id_ed25519.pub")"
    }
    ago() { # seconds, for people
      if (( $1 < 60 )); then echo "$1 s"; elif (( $1 < 3600 )); then echo "$(( $1 / 60 )) min"; else echo "$(( $1 / 3600 )) h $(( $1 % 3600 / 60 )) min"; fi
    }
    pbx_status() { # the tunnel container as it stands now (its current run only: old log lines say nothing), then the API's view
      local cid state started since uptime logs
      cid=$(compose ps -aq pbx 2> /dev/null | head -n 1 || true)
      if [[ -z "$cid" ]]; then
        echo "tunnel: not set up (hubctl pbx link)"
      else
        state=$(docker inspect -f '{{.State.Status}}' "$cid")
        started=$(docker inspect -f '{{.State.StartedAt}}' "$cid")
        since=${started%%.*}
        since=${since%Z}Z
        uptime=$(( $(date +%s) - $(date -d "$since" +%s) ))
        logs=$(docker logs --since "$started" "$cid" 2>&1 | tail -n 5 || true)
        if [[ "$state" == running ]]; then
          if (( uptime < 15 )); then echo "tunnel: up for $(ago "$uptime"), connecting"; else echo "tunnel: up for $(ago "$uptime")"; fi
        else
          echo "tunnel: $state ($(docker inspect -f '{{.RestartCount}}' "$cid") restarts); its last words:"
        fi
        [[ -z "$logs" ]] || while IFS= read -r line; do echo "  | $line"; done <<< "$logs"
        if grep -q "Permission denied (publickey" <<< "$logs"; then
          echo "=> the PBX refuses the hub's key: hubctl pbx link again puts it there (hubctl pbx key prints it, to add by hand)"
        fi
        if grep -q "Host key verification failed\|HOST IDENTIFICATION HAS CHANGED" <<< "$logs"; then
          echo "=> the PBX's host key is not the one the hub knows (reinstalled?): rm $pbx_dir/known_hosts, then hubctl pbx link again"
        fi
      fi
      curl -fsS http://127.0.0.1:8000/phones/status | jq . || echo "api: down"
    }
    case "${2:-status}" in
      key)
        pbx_key
        line=$(pbx_line)
        echo "This hub's key for the PBX. hubctl pbx link root@<pbx> puts it on the PBX itself (the PBX asks for root's"
        echo "password once); to add it by hand instead, run this from any machine that reaches the PBX, as one line:"
        echo
        echo "  ssh root@<pbx> 'echo \"${line//\"/\\\"}\" >> ~/.ssh/authorized_keys'"
        echo
        echo "$line"
        ;;
      link)
        [[ $# -ge 3 ]] || { echo "usage: hubctl pbx link user@pbx-host [ami-user]" >&2; exit 2; }
        pbx_key
        if pbx_ssh -o BatchMode=yes "$3" true 2> /dev/null; then
          echo "The PBX accepts the hub's key."
        else
          echo "The PBX does not accept the hub's key yet: adding it (the PBX asks for the password of $3 once)."
          line=$(pbx_line)
          pbx_ssh "$3" "umask 077; mkdir -p ~/.ssh; grep -qxF '$line' ~/.ssh/authorized_keys 2> /dev/null || echo '$line' >> ~/.ssh/authorized_keys" \
            || { echo "Could not add the key; nothing changed. hubctl pbx key prints it, to add by hand." >&2; exit 1; }
          pbx_ssh -o BatchMode=yes "$3" true 2> /dev/null \
            || { echo "The key is on the PBX, but the PBX still refuses it (sshd there does not read ~/.ssh/authorized_keys?); the link was not written." >&2; exit 1; }
          echo "The PBX accepts the hub's key now."
        fi
        chown "$POS_UID:$POS_UID" "$pbx_dir/known_hosts" 2> /dev/null || true
        saved=$(sed -nE 's/^POS_AMI_SECRET=//p' "$POS_HOME/.env" 2> /dev/null | tail -n 1)
        keeps=""
        [[ -z "$saved" ]] || keeps="; Enter keeps the saved one"
        read -rsp "Secret of the AMI user ${4:-pos} (FreePBX > Settings > Asterisk Manager Users$keeps): " secret
        echo
        secret=${secret:-$saved}
        [[ -n "$secret" ]] || { echo "no secret given; nothing changed" >&2; exit 2; }
        unset_env POS_PBX_SSH POS_AMI_HOST POS_AMI_PORT POS_AMI_USER POS_AMI_SECRET POS_AMI_TLS
        (
          umask 077
          printf 'POS_PBX_SSH=%s\nPOS_AMI_HOST=pbx\nPOS_AMI_USER=%s\nPOS_AMI_SECRET=%s\n' "$3" "${4:-pos}" "$secret" >> "$POS_HOME/.env"
        )
        profile_on pbx
        compose up -d --force-recreate pbx # a fresh start, not the tail of a restart loop
        compose up -d api
        echo "Linked to $3. Waiting for the hub to reach the PBX through the tunnel..."
        for _ in $(seq 1 45); do
          sleep 1
          if [[ "$(curl -fsS http://127.0.0.1:8000/phones/status 2> /dev/null | jq -r '.connected' 2> /dev/null || true)" == true ]]; then
            echo "The hub watches the PBX. hubctl pbx tail prints each call a desk phone answers; the phones are linked to screens under Location settings, Desk phones."
            exit 0
          fi
        done
        echo "Not reached within 45 s. Where it stands:"
        pbx_status
        exit 1
        ;;
      status)
        pbx_status
        ;;
      tail)
        # shellcheck disable=SC2016  # the variables are the container's, expanded in there
        compose exec -T api sh -c 'exec python -m pos.phones.deskphones --host "$POS_AMI_HOST" --port "$POS_AMI_PORT" --user "$POS_AMI_USER" --secret-env POS_AMI_SECRET'
        ;;
      unlink)
        unset_env POS_PBX_SSH POS_AMI_HOST POS_AMI_PORT POS_AMI_USER POS_AMI_SECRET POS_AMI_TLS
        profile_off pbx
        compose --profile pbx stop pbx 2> /dev/null || true
        compose --profile pbx rm -f pbx 2> /dev/null || true
        compose up -d api
        echo "The hub no longer watches the PBX; the key in $pbx_dir stays."
        ;;
      *)
        echo "usage: hubctl pbx key | link user@pbx-host [ami-user] | status | tail | unlink" >&2
        exit 2
        ;;
    esac
    ;;
  push)
    # hubctl push apple AuthKey_KEYID.p8 <key-id> <team-id> [bundle-id]   puts Apple's push key on the hub (the API's user reads it, nobody else), saves the ids in .env, restarts the API
    # hubctl push status                                                  the key, the tokens the screens registered, the extensions marked on the PBX, what went out
    # hubctl push test <device> [alert|voip]                              a notification (or a test call) to that screen, by the name it shows in its status
    # hubctl push forget                                                  removes the key and the ids: no more pushes
    apns_dir="$POS_HOME/apns"
    unset_env() {
      for name in "$@"; do sed -i -E "/^$name=/d" "$POS_HOME/.env"; done
    }
    push_status() {
      curl -fsS http://127.0.0.1:8000/push/status 2> /dev/null | jq -r '
        (if .configured then "key: \(.key_id), team \(.team_id), bundle \(.bundle); \(.sent) sent, \(.failed) failed" + (if .last_error then " (last: \(.last_error))" else "" end) else "key: none (hubctl push apple AuthKey_KEYID.p8 <key-id> <team-id>)" end),
        "tokens: \(.devices.voip) for calls, \(.devices.alert) for pick-ups",
        (.list[] | "  \(.device)  \(.platform)  \(.kind)" + (if .extension != "" then "  extension \(.extension)" else "" end) + (if .env then "  (\(.env))" else "" end)),
        ("pbx: " + (if .pbx then "connected; marked for push: " + (if (.marks | length) > 0 then (.marks | join(", ")) else "nothing" end) + (if .marks_error then "; TROUBLE: \(.marks_error)" else "" end) + (if .hook_seen then "; the pre-dial hook spoke" else "; the pre-dial hook has not spoken yet (docs/push-relay.md, step 7)" end) else "not connected" end)),
        "pushes: \(.pushes.ring) rings, \(.pushes.pop) pick-ups, \(.pushes.test) tests"' || echo "the API is not answering"
    }
    case "${2:-status}" in
      apple)
        [[ $# -ge 5 ]] || { echo "usage: hubctl push apple <AuthKey_KEYID.p8> <key-id> <team-id> [bundle-id]" >&2; exit 2; }
        [[ -f "$3" ]] || { echo "no such file: $3" >&2; exit 2; }
        grep -q 'PRIVATE KEY' "$3" || { echo "$3 is not a .p8 key: no PRIVATE KEY in it" >&2; exit 2; }
        [[ "$4" =~ ^[A-Z0-9]{10}$ ]] || { echo "the key id is the ten letters and digits in the file's name, AuthKey_<key id>.p8, not '$4'" >&2; exit 2; }
        [[ "$5" =~ ^[A-Z0-9]{10}$ ]] || { echo "the team id is ten letters and digits (Membership details in the Apple developer account), not '$5'" >&2; exit 2; }
        install -d -m 0700 -o "$POS_UID" -g "$POS_UID" "$apns_dir"
        install -m 0400 -o "$POS_UID" -g "$POS_UID" "$3" "$apns_dir/AuthKey_$4.p8"
        unset_env POS_APNS_KEY POS_APNS_KEY_ID POS_APNS_TEAM_ID POS_APNS_BUNDLE_ID
        printf 'POS_APNS_KEY=/apns/AuthKey_%s.p8\nPOS_APNS_KEY_ID=%s\nPOS_APNS_TEAM_ID=%s\n' "$4" "$4" "$5" >> "$POS_HOME/.env"
        if [[ -n "${6:-}" ]]; then printf 'POS_APNS_BUNDLE_ID=%s\n' "$6" >> "$POS_HOME/.env"; fi
        app_key_off push_apple
        compose up -d api
        echo "The key is on the hub. Waiting for the API to pick it up..."
        for _ in $(seq 1 30); do
          sleep 1
          if [[ "$(curl -fsS http://127.0.0.1:8000/push/status 2> /dev/null | jq -r '.configured' 2> /dev/null || true)" == true ]]; then
            echo "The hub pushes as team $5 with key $4 for ${6:-org.chinasky.posApp}. Next: on an iPhone, turn the phone on in the app (or link a desk phone to it), then hubctl push test <device>."
            exit 0
          fi
        done
        echo "The API did not come up with the key within 30 s. hubctl logs api says why; hubctl push forget takes the key off again."
        exit 1
        ;;
      status)
        push_status
        ;;
      test)
        [[ $# -ge 3 ]] || { echo "usage: hubctl push test <device> [alert|voip]" >&2; exit 2; }
        curl -fsS -X POST -H 'content-type: application/json' -d "{\"device\":\"$3\",\"kind\":\"${4:-alert}\"}" http://127.0.0.1:8000/push/test \
          | jq -r 'if .configured | not then "no Apple key on this hub (hubctl push apple)" elif .tokens == 0 then "\(.device) has registered no \(.kind) token on this hub: open the app on it (for voip, turn the phone on in the app)" else (.results[] | "\(.device) \(.platform) \(.kind): " + (if .ok then "sent (\(.env))" else "FAILED: \(.reason)" end)) end'
        ;;
      forget)
        unset_env POS_APNS_KEY POS_APNS_KEY_ID POS_APNS_TEAM_ID POS_APNS_BUNDLE_ID
        rm -rf "$apns_dir"
        app_key_off push_apple
        compose up -d --force-recreate api
        echo "The key is gone; the hub sends no pushes until hubctl push apple puts one back."
        ;;
      *)
        echo "usage: hubctl push apple <AuthKey_KEYID.p8> <key-id> <team-id> [bundle-id] | status | test <device> [alert|voip] | forget" >&2
        exit 2
        ;;
    esac
    ;;
  maps)
    # hubctl maps key                puts a map service's key on the hub (asked for and not shown, never on the command line), restarts the API
    # hubctl maps google             puts a Google Maps key on the hub the same way: Google is asked when the first service gives no distance
    # hubctl maps status             whether the hub has a key, whether the restaurant's own address is set, how often it asked today
    #                                and how often it did not have to (a customer's own earlier order said how far); the same of Google,
    #                                and whether live traffic is on and how often the roads were asked about
    #                                and of each map service the list of addresses while typing can ask (Google, then Mapbox, then
    #                                Azure Maps; their keys are typed in the app): whether it is on, and how often it was asked
    #                                this month, of how many
    # hubctl maps test "<address>"   asks how far an address is, as a delivery's form does, and says which service answered;
    #                                where live traffic is on, also how long the drive is right now
    # hubctl maps test google "<address>"   asks Google alone, to try its key (geocodio in its place asks the first alone)
    # hubctl maps forget             removes the first service's key
    # hubctl maps forget google      removes Google's key
    unset_env() {
      for name in "$@"; do sed -i -E "/^$name=/d" "$POS_HOME/.env"; done
    }
    read_key() { # $1: whose key is asked for; the key is left in $key
      read -rsp "$1 (it is not shown as you paste it): " key
      echo
      key=${key//[[:space:]]/}
      [[ -n "$key" ]] || { echo "no key given; nothing changed" >&2; exit 2; }
      [[ "$key" =~ ^[A-Za-z0-9_-]{16,128}$ ]] || { echo "that does not look like a key (letters and digits, 16 or more, no spaces); nothing changed" >&2; exit 2; }
    }
    has_service() { # $1: a service's name; waits up to 30 s for the API to say it has it
      for _ in $(seq 1 30); do
        sleep 1
        if [[ "$(curl -fsS http://127.0.0.1:8000/maps/status 2> /dev/null | jq -r --arg name "$1" '[.service, .fallback.service] | index($name) != null' 2> /dev/null || true)" == true ]]; then
          return 0
        fi
      done
      return 1
    }
    maps_status() {
      curl -fsS http://127.0.0.1:8000/maps/status 2> /dev/null | jq -r '
        (if .configured then "map service: \(.service); asked \(.asked_today) times today (at most \(.daily_most)), \(.failed_today) gave no distance" + (if .last_failure then " (last: \(.last_failure))" else "" end) else "map service: none (hubctl maps key)" end),
        (if .fallback then "second map service: \(.fallback.service), asked when the first gives no distance; asked \(.fallback.asked_today) times today (at most \(.fallback.daily_most)), \(.fallback.failed_today) gave no distance" + (if .fallback.last_failure then " (last: \(.fallback.last_failure))" else "" end) elif .configured and has("fallback") and .service != "google" then "second map service: none (hubctl maps google)" else empty end),
        (if .traffic then "live traffic for the promised time: " + (if .traffic.enabled then "on" else "off (in the app: Location, Live traffic)" end) + "; \(.traffic.service) was asked about the roads \(.traffic.asked_today) times today (at most \(.traffic.daily_most)), \(.traffic.failed_today) gave no answer" + (if .traffic.last_failure then " (last: \(.traffic.last_failure))" else "" end) else empty end),
        ((.suggests // [.suggest // empty]) | to_entries[] | .key as $place | .value | "the list of addresses while typing" + (if $place == 0 then "" else ", when the one before it gives no list" end) + ": \(.service), " + (if .enabled then "on" else "off (in the app: Location, Address list)" end) + (if .monthly_most != null then "; asked \(.asked_month) times this month (at most \(.monthly_most), \(.left) left), \(.asked_today) today" else "; asked \(.asked_today) times today (at most \(.daily_most))" end) + ", \(.failed_today) gave no list" + (if .last_failure then " (last: \(.last_failure))" else "" end) + (if .resting then "; left alone for a moment after it gave no answer" else "" end) + (if .placed == true then "; knows where the restaurant is" elif .placed == false then "; does not know where the restaurant is yet" else "" end)),
        (if .configured and .saved_today != null then "not asked, because the customer\u0027s own earlier order said how far: \(.saved_today) times today" else empty end),
        (if .origin_set then "the restaurant\u0027s own address: set" else "the restaurant\u0027s own address: not set (in the app: Location, Delivery fee)" end)' || echo "the API is not answering, or is older than the lookup (hubctl update)"
    }
    case "${2:-status}" in
      key)
        read_key "The map service's API key"
        unset_env POS_MAPS POS_MAPS_KEY
        printf 'POS_MAPS=geocodio\nPOS_MAPS_KEY=%s\n' "$key" >> "$POS_HOME/.env"
        unset key
        app_key_off maps
        compose up -d api
        echo "The key is on the hub. Waiting for the API to pick it up..."
        if has_service geocodio; then
          maps_status
          echo "Next: in the app, Location, Delivery fee: type the restaurant's own address. Then: hubctl maps test \"an address nearby\""
          exit 0
        fi
        echo "The API did not come up with the key within 30 s. hubctl logs api says why; hubctl maps forget takes the key off again."
        exit 1
        ;;
      google)
        read_key "The Google Maps Platform API key"
        unset_env POS_MAPS_GOOGLE_KEY
        printf 'POS_MAPS_GOOGLE_KEY=%s\n' "$key" >> "$POS_HOME/.env"
        unset key
        app_key_off maps_google
        compose up -d api
        echo "The key is on the hub. Waiting for the API to pick it up..."
        if has_service google; then
          maps_status
          echo "Next: hubctl maps test google \"an address nearby\""
          exit 0
        fi
        echo "The API did not come up with the key within 30 s, or is older than the second map service (hubctl update). hubctl logs api says why; hubctl maps forget google takes the key off again."
        exit 1
        ;;
      status)
        maps_status
        ;;
      test)
        # with a service's name before the address, that service alone is asked
        case "${3:-}" in
          geocodio | google) via="$3" address="${4:-}" ;;
          *) via="" address="${3:-}" ;;
        esac
        [[ -n "$address" ]] || { echo 'usage: hubctl maps test [geocodio|google] "<address>"' >&2; exit 2; }
        jq -n --arg address "$address" --arg via "$via" '{address: $address} + (if $via == "" then {now: true} else {via: $via} end)' \
          | curl -sS -X POST -H 'content-type: application/json' -d @- http://127.0.0.1:8000/delivery/distance \
          | jq -r 'if (.detail | type) == "object" then .detail.message elif .detail then (.detail | tostring) else "\(.miles) mi, \(.minutes) min" + (if .band then ": $\(.band.fee) (up to \(.band.up_to) \(.by))" elif .beyond then ": further than the prices reach" else ": no fee is charged" end) + (if .credit then " [\(.credit)]" elif .service then " [\(.service)]" else "" end) + (if .drive_now then "; the drive right now: \(.drive_now.minutes) min" + (if .drive_now.credit then " [\(.drive_now.credit)]" else "" end) else "" end) end'
        ;;
      forget)
        if [[ "${3:-}" == google ]]; then
          unset_env POS_MAPS_GOOGLE_KEY
          app_key_off maps_google
          compose up -d --force-recreate api
          echo "Google's key is gone from the hub. (The key itself is deleted in the Google Cloud console.)"
        elif [[ -n "${3:-}" ]]; then
          echo 'usage: hubctl maps forget [google]' >&2
          exit 2
        else
          unset_env POS_MAPS POS_MAPS_KEY
          app_key_off maps
          compose up -d --force-recreate api
          if [[ "$(curl -fsS --retry 20 --retry-all-errors --retry-delay 1 http://127.0.0.1:8000/maps/status 2> /dev/null | jq -r '.configured' 2> /dev/null || true)" == true ]]; then
            echo "The key is gone. Google's key is still on the hub, and Google is now asked about every address (hubctl maps forget google takes it off too)."
          else
            echo "The key is gone; no distance is looked up, and the delivery fee is picked by hand."
          fi
        fi
        ;;
      *)
        echo 'usage: hubctl maps key | google | status | test [geocodio|google] "<address>" | forget [google]' >&2
        exit 2
        ;;
    esac
    ;;
  online)
    # hubctl online key              puts GloriaFood's key for this restaurant on the hub (asked for and not shown, never on the
    #                                command line), restarts the API; from then on the hub asks GloriaFood for accepted orders every minute.
    #                                It is the first account's key: a second website or a testing account is added in the app
    #                                (Location, Keys and connections), each with its own key, and `status` lists each
    # hubctl online status           whether the hub has the key, when GloriaFood last answered, today's online orders by what became
    #                                of them, and the ones somebody should look at, each by GloriaFood's own number
    # hubctl online fetch            asks GloriaFood now instead of within the minute
    # hubctl online show <number>    one order as GloriaFood sent it, by its number, with everything of the customer taken out:
    #                                for looking at an order that went on the POS wrong
    # hubctl online forget           removes the key: the hub asks nobody; the orders already on the POS stay as they are
    # The key for pushes and the tunnel's token can be typed in the app instead (Location, Keys and connections), and
    # tried there. Of the two ways the one used last wins: a key told here takes off what the app was told.
    # hubctl online push key         puts the key GloriaFood's own pushes carry on the hub (asked for and not shown; Enter alone and
    #                                the hub makes one, shown once, to put into GloriaFood's admin), and opens the push door
    # hubctl online push test [https://<address>/online/push]
    #                                sends an empty push through the door, or with an address through the whole way in from
    #                                outside, and says whether it got in; puts nothing on the POS. For a key put on here
    # hubctl online push forget      removes that key and shuts the door (and stops the tunnel): the hub only asks
    # hubctl online tunnel token     puts a Cloudflare Tunnel's token on the hub (asked for and not shown) and starts the tunnel
    # hubctl online tunnel status    the tunnel as it stands, and its last words
    # hubctl online tunnel forget    stops the tunnel and removes its token
    unset_env() {
      for name in "$@"; do sed -i -E "/^$name=/d" "$POS_HOME/.env"; done
    }
    env_of() {
      sed -nE "s/^$1=//p" "$POS_HOME/.env" 2> /dev/null | tail -n 1
    }
    state_of() { # one of the hub's optional services as it stands: running, restarting, exited, or "not set up"
      local cid
      cid=$(compose ps -aq "$1" 2> /dev/null | head -n 1 || true)
      if [[ -n "$cid" ]]; then docker inspect -f '{{.State.Status}}' "$cid"; else echo "not set up"; fi
    }
    online_status() {
      curl -fsS http://127.0.0.1:8000/online/status 2> /dev/null | jq -r --arg door "$(state_of door)" '
        def at: if . then (. / 1000 | strflocaltime("%H:%M")) else "never" end;
        def tunnel: (.push.tunnel // {}) as $t | if ($t.there // false) | not then "" elif $t.state == "connected" then "; the tunnel is connected to Cloudflare" elif $t.state == "starting" then "; the tunnel is on its way to Cloudflare" elif $t.state == "failing" then "; THE TUNNEL IS NOT CONNECTED (hubctl online tunnel status)" else "" end;
        (if .configured or .push.configured then "online orders: on" else "online orders: off, no key (hubctl online push key, hubctl online key)" end),
        (if .push.configured then "  sent by GloriaFood (push): on; last push " + (.push.pushed_ms | at) + "; the door is " + $door + tunnel else "  sent by GloriaFood (push): off (hubctl online push key)" end),
        (if .configured then "  asked for every minute: " + (if .running then "on" else "NOT RUNNING: hubctl restart" end) + "; last answer " + (.answered_ms | at) else "  asked for every minute: off, no key (hubctl online key)" + (if .push.configured then ". Nothing brings an order whose push is lost" else "" end) end),
        ((.accounts // []) | if length > 1 then (.[] | "    " + (if .name != "" then .name else "the first account" end) + (if .test then " (for testing)" else "" end) + ": " + (if .configured then "last answer " + (.answered_ms | at) + (if .last_failure then "; TROUBLE at " + (.last_failure.at_ms | at) + ": " + .last_failure.reason else "" end) + "; \(.came) today" else "no key (in the app: Location, Keys and connections)" end)) else empty end),
        (if (.configured or .push.configured) and (.writable | not) then "this hub cannot write orders down now (it is the standby), so it takes none" else empty end),
        (if .push.configured and $door != "running" then "TROUBLE: the push door is not running, so no push gets in: hubctl logs door" else empty end),
        (if .last_failure then "TROUBLE asking at " + (.last_failure.at_ms | at) + ": " + .last_failure.reason else empty end),
        (if .push.refused then "  turned away: \(.push.refused.count) without the right key since the hub started, the last at " + (.push.refused.at_ms | at) + " (" + .push.refused.reason + ")" else empty end),
        (if .push.refused and .today.by_push == 0 and .today.by_poll > 0 then "  => orders come only by asking while pushes are turned away: the key in GloriaFood'"'"'s admin is probably not the one on the hub (hubctl online push key)" else empty end),
        "today: \(.today.came) came (\(.today.by_push) sent by GloriaFood, \(.today.by_poll) asked for), \(.today.placed) on the POS, \(.today.booked // 0) tables into the reservation book, \(.today.kept) not for the POS, \(.today.failed) could not be put on; \(.waiting) waiting",
        (if .today.unread > 0 then "  \(.today.unread) of what GloriaFood sent could not be read (below)" else empty end),
        (if (.look | length) > 0 then "to look at:" else empty end),
        (.look[] | (.kind == "table_reservation" or .kind == "order_ahead") as $table | "  \(.id)  " + (.fetched_ms | at) + "  " + (if .store then .store + (if .test then " (for testing)" else "" end) + ": " else "" end) + (if .state == "placed" then "on the POS" elif .state == "booked" then "in the reservation book" elif .state == "kept" then (if $table then "not in the reservation book" else "not on the POS" end) elif .kind == "unreadable" then "could not be read" elif $table then "NOT IN THE RESERVATION BOOK" else "NOT ON THE POS" end) + ": " + .said)' || echo "the API is not answering, or is older than online orders (hubctl update)"
    }
    push_try() { # an empty push to an address, with or without the hub's key: prints the answer's number and what it said
      local url=$1 key=${2:-}
      if [[ -n "$key" ]]; then
        printf 'Authorization: %s\n' "$key" | curl -sS -o - -w '\n%{http_code}' --max-time 20 -X POST -H @- -H 'Content-Type: application/json' --data '{"count": 0, "orders": []}' "$url" 2> /dev/null || true
      else
        curl -sS -o - -w '\n%{http_code}' --max-time 20 -X POST -H 'Content-Type: application/json' --data '{"count": 0, "orders": []}' "$url" 2> /dev/null || true
      fi
    }
    push_test() { # through the door on the hub, or with an address through the whole way in from outside
      local key answer code url=${1:-}
      key=$(env_of POS_GLORIAFOOD_PUSH_KEY)
      if [[ -z "$key" ]]; then
        if [[ "$(curl -fsS http://127.0.0.1:8000/online/status 2> /dev/null | jq -r '.push.configured' 2> /dev/null || true)" == true ]]; then
          echo "the key for pushes was typed in the app, and the hub's terminal does not have it. Try it there: Location, Keys and connections, Try it."
        else
          echo "this hub has no key for pushes (hubctl online push key, or in the app: Location, Keys and connections)"
        fi
        return 1
      fi
      if [[ -z "$url" ]]; then
        answer=$(push_try http://127.0.0.1:8090/online/push "$key")
        code=${answer##*$'\n'}
        case "$code" in
          200) echo "the door: an empty push with the hub's key got in (it puts nothing on the POS)" ;;
          401) echo "the hub's own key was turned away: the door and the API are running with another key than the one in $POS_HOME/.env. hubctl update starts them with it"; return 1 ;;
          404) echo "the door is shut: it was started without the key. hubctl update starts it with it"; return 1 ;;
          502 | 504) echo "the door is up, but the API behind it did not answer ($code): hubctl status"; return 1 ;;
          *) echo "the door did not answer (hubctl logs door)"; return 1 ;;
        esac
        return 0
      fi
      # From outside. First without the key: only this hub's door answers 401 "refused", and the key is sent
      # to nobody who does not.
      answer=$(push_try "$url")
      code=${answer##*$'\n'}
      if [[ "$code" != 401 || "$answer" != *'"refused"'* ]]; then
        echo "that address does not lead to this hub's door (it answered ${code:-nothing}). The hub's key was not sent."
        echo "Look at the way in: the address must end in /online/push and must be handed to http://door:8090 (hubctl online tunnel status)."
        return 1
      fi
      answer=$(push_try "$url" "$key")
      code=${answer##*$'\n'}
      if [[ "$code" == 200 ]]; then
        echo "the whole way in works: a push to $url with the hub's key reached the POS (an empty one: nothing was put on it)."
        echo "That is the address for GloriaFood's admin. (The test counts as one push turned away and one push in hubctl online status.)"
      else
        echo "that address leads to the door, but a push with the hub's key was answered $code. hubctl online status says more."
        return 1
      fi
    }
    tunnel_status() { # the tunnel as its keeper says it stands (the API reads it), and Cloudflare's program's last words
      local told state
      told=$(curl -fsS http://127.0.0.1:8000/online/status 2> /dev/null | jq -c '.push.tunnel // empty' 2> /dev/null || true)
      if [[ -z "$told" ]]; then
        echo "tunnel: the API is not answering, or is older than this (hubctl update)"
        return 0
      fi
      jq -r '
        def at: if . then (. / 1000 | strflocaltime("%H:%M")) else "a moment ago" end;
        def why: if .reason == "refused" then "Cloudflare did not take the token. Copy it again from the tunnel in Cloudflare (hubctl online tunnel token, or in the app)" elif .reason == "unreachable" then "the hub cannot reach Cloudflare. Is its internet up?" elif .reason == "slow" then "it is taking long to reach Cloudflare" elif .reason == "missing" then "this hub has no cloudflared (hubctl update builds it in)" else "see its last words" end;
        if (.there | not) then "tunnel: its keeper is not running on this hub (hubctl update; hubctl logs tunnel)"
        elif .state == "connected" then "tunnel: connected to Cloudflare since " + (.since_ms | at)
        elif .state == "starting" then "tunnel: on its way to Cloudflare, not connected yet"
        elif .state == "failing" then "tunnel: NOT connected to Cloudflare since " + (.since_ms | at) + ": " + why
        else "tunnel: no token (hubctl online tunnel token, or in the app: Location, Keys and connections)" end' <<< "$told"
      state=$(jq -r 'if .there then .state else "gone" end' <<< "$told")
      if [[ "$state" == failing || "$state" == starting || "$state" == gone ]]; then
        compose logs --no-log-prefix --tail 8 tunnel 2> /dev/null | while IFS= read -r line; do echo "  | $line"; done || true
      fi
    }
    tunnel_state() {
      curl -fsS http://127.0.0.1:8000/online/status 2> /dev/null | jq -r '.push.tunnel | if .there then .state else "gone" end' 2> /dev/null || true
    }
    case "${2:-status}" in
      key)
        read -rsp "GloriaFood's key for this restaurant (it is not shown as you paste it): " key
        echo
        key=${key//[[:space:]]/}
        [[ -n "$key" ]] || { echo "no key given; nothing changed" >&2; exit 2; }
        [[ "$key" =~ ^[A-Za-z0-9._~+/=-]{8,200}$ ]] || { echo "that does not look like a key (letters and digits, 8 or more, no spaces); nothing changed" >&2; exit 2; }
        unset_env POS_GLORIAFOOD_KEY
        printf 'POS_GLORIAFOOD_KEY=%s\n' "$key" >> "$POS_HOME/.env"
        unset key
        app_key_off online
        compose up -d api
        echo "The key is on the hub. Waiting for the API to pick it up..."
        for _ in $(seq 1 30); do
          sleep 1
          if [[ "$(curl -fsS http://127.0.0.1:8000/online/status 2> /dev/null | jq -r '.configured' 2> /dev/null || true)" == true ]]; then
            sleep 3 # the first round, so the status says whether GloriaFood took the key
            online_status
            echo "From now on an order accepted in GloriaFood's app goes on the POS within the minute. hubctl online status says how they are doing."
            exit 0
          fi
        done
        echo "The API did not come up with the key within 30 s, or is older than online orders (hubctl update). hubctl logs api says why; hubctl online forget takes the key off again."
        exit 1
        ;;
      status)
        online_status
        ;;
      fetch)
        curl -sS -X POST http://127.0.0.1:8000/online/fetch \
          | jq -r 'if (.detail | type) == "object" then .detail.message elif .detail then (.detail | tostring) else (if .asked then "asked: \(.came) came" + (if .known > 0 then " (\(.known) of them here already)" else "" end) + ", \(.placed) on the POS, \(.booked // 0) tables into the reservation book, \(.kept) not for the POS, \(.failed) could not be put on" elif .soon then "not asked: GloriaFood was asked a few seconds ago; try again in a moment" else "not asked: this hub cannot write orders down now" end) + (if .status.last_failure then "; TROUBLE: " + .status.last_failure.reason else "" end) end'
        ;;
      show)
        [[ "${3:-}" =~ ^[A-Za-z0-9_-]{1,64}$ ]] || { echo "usage: hubctl online show <GloriaFood's number for the order>" >&2; exit 2; }
        curl -sS "http://127.0.0.1:8000/online/orders/$3" | jq 'if (.detail | type) == "object" then .detail.message else . end'
        ;;
      forget)
        unset_env POS_GLORIAFOOD_KEY
        app_key_off online
        compose up -d --force-recreate api
        echo "The key is gone from the hub: it asks GloriaFood for nothing. The orders already on the POS stay as they are. (The key itself is removed in GloriaFood's admin.)"
        [[ -z "$(env_of POS_GLORIAFOOD_PUSH_KEY)" ]] || echo "Pushes are still taken (hubctl online push forget stops them), and nothing brings an order whose push is lost."
        ;;
      push)
        case "${3:-}" in
          key)
            echo "The key GloriaFood's pushes carry (the integration's master key in GloriaFood's admin)."
            echo "Paste the one GloriaFood shows, or press Enter alone and the hub makes one for you to put there."
            read -rsp "Key (it is not shown as you paste it): " key
            echo
            key=${key//[[:space:]]/}
            made=""
            if [[ -z "$key" ]]; then
              key=$(head -c 48 /dev/urandom | base64 | tr -d '/+=\n' | cut -c1-40)
              made=yes
            fi
            [[ "$key" =~ ^[A-Za-z0-9._~+/=-]{16,200}$ ]] || { echo "that does not look like a key (letters and digits, 16 or more, no spaces); nothing changed" >&2; exit 2; }
            unset_env POS_GLORIAFOOD_PUSH_KEY
            (
              umask 077
              printf 'POS_GLORIAFOOD_PUSH_KEY=%s\n' "$key" >> "$POS_HOME/.env"
            )
            app_key_off online_push
            compose up -d api door
            if [[ -n "$made" ]]; then
              echo "The hub made this key. Put it into GloriaFood's admin as the integration's master key. It is shown this once"
              echo "(hubctl online push key makes another, should it be lost):"
              echo
              echo "  $key"
              echo
            fi
            unset key
            echo "The key is on the hub. Waiting for the API and the door to pick it up..."
            for _ in $(seq 1 30); do
              sleep 1
              if [[ "$(curl -fsS http://127.0.0.1:8000/online/status 2> /dev/null | jq -r '.push.configured' 2> /dev/null || true)" == true ]]; then
                sleep 2 # the door starts beside the API
                push_test || true
                online_status
                echo "Pushes are taken at the door. Nothing reaches the door from outside until there is a way in: hubctl online tunnel token (docs/online-orders.md, \"The way in\")."
                exit 0
              fi
            done
            echo "The API did not come up with the key within 30 s, or is older than pushes (hubctl update). hubctl logs api says why; hubctl online push forget takes the key off again."
            exit 1
            ;;
          test)
            if [[ $# -ge 4 ]]; then
              [[ "$4" =~ ^https://[A-Za-z0-9.-]+(:[0-9]+)?/online/push$ ]] || { echo "usage: hubctl online push test [https://<your address>/online/push]" >&2; exit 2; }
            fi
            push_test "${4:-}"
            ;;
          forget)
            unset_env POS_GLORIAFOOD_PUSH_KEY POS_TUNNEL_TOKEN
            app_key_off online_push
            app_key_off online_tunnel
            profile_off tunnel
            profile_off push
            compose up -d api door tunnel
            echo "The key for pushes is gone from the hub, and the tunnel's token with it: within the minute the door is shut and the tunnel stopped, and every push is turned away."
            if [[ -n "$(env_of POS_GLORIAFOOD_KEY)" ]]; then echo "The hub still asks GloriaFood every minute, so orders keep arriving."; fi
            echo "(Remove the push integration in GloriaFood's admin too, and the tunnel in Cloudflare's.)"
            ;;
          *)
            echo "usage: hubctl online push key | test [https://<your address>/online/push] | forget" >&2
            exit 2
            ;;
        esac
        ;;
      tunnel)
        case "${3:-status}" in
          token)
            if [[ -z "$(env_of POS_GLORIAFOOD_PUSH_KEY)" && "$(curl -fsS http://127.0.0.1:8000/online/status 2> /dev/null | jq -r '.push.configured' 2> /dev/null || true)" != true ]]; then
              echo "First the key for pushes (hubctl online push key, or in the app): the tunnel leads to the door, and the door is shut without it." >&2
              exit 2
            fi
            read -rsp "The tunnel's token from Cloudflare (it is not shown as you paste it): " token
            echo
            token=${token//[[:space:]]/}
            [[ "$token" =~ ^[A-Za-z0-9_=+/-]{40,4000}$ ]] || { echo "that does not look like a tunnel's token (one long run of letters and digits, usually starting with eyJ); nothing changed" >&2; exit 2; }
            unset_env POS_TUNNEL_TOKEN
            (
              umask 077
              printf 'POS_TUNNEL_TOKEN=%s\n' "$token" >> "$POS_HOME/.env"
            )
            unset token
            app_key_off online_tunnel
            compose up -d api door tunnel
            echo "The token is on the hub. Waiting for the tunnel to reach Cloudflare..."
            for _ in $(seq 1 60); do
              sleep 1
              if [[ "$(tunnel_state)" == connected ]]; then
                tunnel_status
                echo "In Cloudflare, the tunnel's public hostname must be handed to http://door:8090. Then: hubctl online push test https://<that hostname>/online/push"
                exit 0
              fi
            done
            tunnel_status
            echo "Not connected within a minute. hubctl logs tunnel says more; hubctl online tunnel forget takes the token off again."
            exit 1
            ;;
          status)
            tunnel_status
            ;;
          forget)
            unset_env POS_TUNNEL_TOKEN
            app_key_off online_tunnel
            profile_off tunnel
            compose up -d api tunnel
            echo "The tunnel's token is gone from the hub, and within the minute the tunnel is stopped: nothing reaches the door from outside. The hub's asking still brings the orders. (Delete the tunnel in Cloudflare too.)"
            ;;
          *)
            echo "usage: hubctl online tunnel token | status | forget" >&2
            exit 2
            ;;
        esac
        ;;
      *)
        echo "usage: hubctl online key | status | fetch | show <number> | forget | push key|test|forget | tunnel token|status|forget" >&2
        exit 2
        ;;
    esac
    ;;
  staff)
    # The staff are changed in the app, by a manager (Location, Staff and PINs; docs/staff.md). This is the
    # way back in when no manager can sign in any more: the list, and a new PIN for one person. The PIN goes
    # to the API's own program on its standard input, never on a command line, and is in force within the
    # minute with no restart.
    case "${2:-list}" in
      list)
        compose exec -T api python -m pos.identity.staffctl list
        ;;
      pin)
        who="${3:-}"
        [[ -n "$who" && $# -eq 3 ]] || { echo "usage: hubctl staff pin <id or name>   (hubctl staff lists everybody)" >&2; exit 2; }
        read -rsp "New PIN for $who (four digits; it is not shown as you type): " pin
        echo
        read -rsp "The same PIN once more: " again
        echo
        if [[ "$pin" != "$again" ]]; then
          unset pin again
          echo "The two are not the same. Nothing was changed." >&2
          exit 1
        fi
        unset again
        printf '%s\n' "$pin" | compose exec -T api python -m pos.identity.staffctl pin "$who"
        unset pin
        ;;
      *)
        echo "usage: hubctl staff | hubctl staff pin <id or name>" >&2
        exit 2
        ;;
    esac
    ;;
  backup)
    mkdir -p /var/backups/pos
    file="/var/backups/pos/pos-$(date +%Y%m%d-%H%M%S).sql.gz"
    compose exec -T db pg_dump -U pos pos | gzip > "$file"
    echo "$file"
    ;;
  *)
    echo "usage: hubctl status | logs [service] | update | restart | psql | backup | printers <list> | print <printer-ip> [demo|ascii|drawer] [escpos|star] | menu import [--apply] | pbx key|link|status|tail|unlink | push apple|status|test|forget | maps key|google|status|test|forget | online key|status|fetch|show|forget|push key|push test|push forget|tunnel token|tunnel status|tunnel forget | staff [pin <id or name>]" >&2
    exit 2
    ;;
esac
